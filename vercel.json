{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/patients",
      "destination": "/overseas-care",
      "permanent": true
    },
    {
      "source": "/patients/",
      "destination": "/overseas-care",
      "permanent": true
    }
  ]
}
